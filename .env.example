# Example environment variables for production
# Copy this to .env and fill values before running in production

FLASK_ENV=production
HOST=0.0.0.0
PORT=5000
DEBUG=0

# Database (if using sqlite leave as is, else set a postgres URL)
DATABASE_URL=sqlite:///patterns.db

# Optional Redis cache
REDIS_URL=redis://localhost:6379/0

# Secret used for sessions or signing (set a strong random value)
SECRET_KEY=replace-with-a-secure-random-value

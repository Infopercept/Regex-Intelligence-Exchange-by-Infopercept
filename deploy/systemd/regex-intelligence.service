[Unit]
Description=Regex Intelligence Exchange (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/regex-intel
EnvironmentFile=/opt/regex-intel/.env
ExecStart=/usr/bin/gunicorn -w 4 -b 127.0.0.1:5000 web.wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
